(defun vl:set-mtext-mask-scale (ename scale / elst)
  (setq elst (entget ename '("*")))

  (if (assoc 45 elst)
    (setq elst
          (subst
            (cons 45 (float scale))
            (assoc 45 elst)
            elst))
    (setq elst
          (append elst
                  (list (cons 45 (float scale)))))
  )

  (entmod elst)
  (entupd ename)
  ename
)

;;; ------------------------------------------------------------
;;; Создаёт слой, если его нет. Возвращает имя слоя.
;;; ------------------------------------------------------------
(defun vl:ensure-layer (layer-name aci-color / doc layers lay res)
  (vl-load-com)
  (setq doc    (vla-get-ActiveDocument (vlax-get-acad-object)))
  (setq layers (vla-get-Layers doc))
  (setq res (vl-catch-all-apply 'vla-Item (list layers layer-name)))
  (if (vl-catch-all-error-p res)
    (progn
      (setq lay (vla-Add layers layer-name))
      (vl-catch-all-apply '(lambda () (vla-put-Color lay aci-color)))
    )
  )
  layer-name
)

;;; ------------------------------------------------------------
;;; Создаёт MTEXT с маской фона. Номера вершин: зелёный цвет (3),
;;; слой «вершины координат».
;;; ------------------------------------------------------------
(defun vl:create-mtext-masked
       (ins-pt txt-str height width just style-name
        / doc mspace mt en vert-layer)

  (vl-load-com)

  (setq vert-layer "вершины координат")
  (vl:ensure-layer vert-layer 3)

  (setq doc    (vla-get-ActiveDocument (vlax-get-acad-object)))
  (setq mspace (vla-get-ModelSpace doc))

  (setq mt
        (vla-AddMText
          mspace
          (vlax-3d-point ins-pt)
          (float width)
          txt-str))

  (if mt
    (progn

      ;; Высота
      (vla-put-Height mt (float height))

      ;; Стиль
      (vl-catch-all-apply
        '(lambda ()
           (vla-put-StyleName mt style-name)))

      ;; Выравнивание
      (vla-put-AttachmentPoint mt just)

      ;; Слой и цвет (зелёный = 3)
      (vl-catch-all-apply
        '(lambda ()
           (vla-put-Layer mt vert-layer)))
      (vl-catch-all-apply
        '(lambda ()
           (vla-put-Color mt 3)))

      ;; Маска
      (vl-catch-all-apply
        '(lambda ()
           (vla-put-BackgroundFill mt :vlax-true)
           (vla-put-BackgroundColor mt 254)
         )
      )

      ;; Получаем имя объекта
      (setq en (vlax-vla-object->ename mt))

      ;; Принудительно меняем DXF код 45
      (vl:set-mtext-mask-scale en 1.05)

      en
    )
  )
)


;;; ------------------------------------------------------------
;;; Вставляет блок с атрибутами координат — альтернатива MLEADER.
;;; Блок должен быть атрибутивным, с тегами атрибутов "X" и "Y".
;;; Блок вставляется точкой вставки прямо в вершину полилинии —
;;; никакой дополнительной "выносной" геометрии не создаётся.
;;;
;;; Строки x-str/y-str должны уже содержать знак +/- (см.
;;; vl:fmt-coord) — они попадают в атрибуты как есть, без
;;; дополнительных префиксов "X="/"Y=" (эти префиксы уже
;;; нарисованы статикой внутри самого блока).
;;;
;;; Высота текста атрибутов X/Y принудительно выставляется равной
;;; txt-height — той же высоте, что используется для мультивыносок
;;; и подписей номеров вершин. Это гарантирует одинаковый размер
;;; текста независимо от масштаба, в котором нарисован сам блок.
;;;
;;; Аргументы:
;;;   pt-vertex  — точка вершины полилинии (она же точка вставки блока)
;;;   block-name — имя блока в чертеже (блок должен уже существовать —
;;;                см. vl:ensure-coord-block-from-template)
;;;   x-str,y-str— отформатированные строки координат (со знаком +/-)
;;;   scale      — масштаб вставки блока (геометрия/пропорции блока,
;;;                НЕ высота текста — та задаётся отдельно)
;;;   txt-height — требуемая высота текста атрибутов (как у мультивыноски)
;;;
;;; Возвращает: entity name вставленного блока или nil
;;; ------------------------------------------------------------

;; --- Глобальные переменные для системы реакторов координатных блоков ---

(if (not *VL:COORD-REACTORS*)          (setq *VL:COORD-REACTORS* '()))
(if (not *VL:COORD-BLOCK-NAME*)        (setq *VL:COORD-BLOCK-NAME* nil))
(if (not *VL:COORD-DIRTY*)             (setq *VL:COORD-DIRTY* '()))
(if (not *VL:COORD-CMD-REACTOR*)       (setq *VL:COORD-CMD-REACTOR* nil))
(if (not *VL:COORD-ATTACHED-HANDLES*)  (setq *VL:COORD-ATTACHED-HANDLES* '()))

;; ------------------------------------------------------------
;; Пересчитывает и перезаписывает атрибуты X/Y блока по его
;; ТЕКУЩЕЙ точке вставки (InsertionPoint). Использует тот же
;; формат, что и при первичной вставке (vl:fmt-coord).
;; Вызывать ТОЛЬКО когда безопасно менять объект (после
;; завершения команды, не изнутри :vlr-modified!).
;; ------------------------------------------------------------
(defun vl:refresh-coord-attrs (blk-obj / pt x y atts att tag)
  (setq pt (vl-catch-all-apply 'vlax-get (list blk-obj 'InsertionPoint)))
  (if (not (vl-catch-all-error-p pt))
    (progn
      (setq x (cadr pt))   ; "геодезическая" X = вертикаль чертежа
      (setq y (car pt))    ; "геодезическая" Y = горизонталь чертежа
      (setq atts (vl-catch-all-apply 'vlax-invoke (list blk-obj 'GetAttributes)))
      (if (not (vl-catch-all-error-p atts))
        (foreach att atts
          (setq tag (strcase (vla-get-TagString att)))
          (cond
            ((member tag '("X" "Х")) (vla-put-TextString att (strcat "X= " (vl:fmt-coord x))))
            ((member tag '("Y" "У")) (vla-put-TextString att (strcat "Y= " (vl:fmt-coord y))))
          )
        )
      )
      (vl-catch-all-apply 'vla-Update (list blk-obj))
    )
  )
)

;; ------------------------------------------------------------
;; Callback объектного реактора (:vlr-modified).
;; КРИТИЧЕСКИ ВАЖНО: здесь НЕЛЬЗЯ менять blk-obj (и его атрибуты) —
;; AutoCAD ещё находится в процессе рассылки уведомления, и попытка
;; изменить объект прямо тут вызывает аварийное завершение
;; (dbattr.cpp eWasNotifying). Поэтому только откладываем работу —
;; складываем объект в список "грязных" для последующей обработки.
;; ------------------------------------------------------------
(defun vl:coord-block-modified (notifier-obj reactor-obj param-list / )
  (if (not (member notifier-obj *VL:COORD-DIRTY*))
    (setq *VL:COORD-DIRTY* (cons notifier-obj *VL:COORD-DIRTY*))
  )
)

;; ------------------------------------------------------------
;; Ищет в чертеже все вставки координатного блока, у которых ещё
;; нет реактора (новые копии), навешивает на них реактор и сразу
;; пересчитывает их X/Y по текущему положению.
;; Вызывается после КАЖДОЙ команды (см. vl:coord-cmd-ended) —
;; поэтому копирование блока подхватывается автоматически.
;; ------------------------------------------------------------
(defun vl:auto-attach-new-coord-blocks (/ bname ss i ent obj hnd)
  (setq bname (if *VL:COORD-BLOCK-NAME* *VL:COORD-BLOCK-NAME* nil))
  (if bname
    (progn
      (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 bname))))
      (if ss
        (progn
          (setq i 0)
          (repeat (sslength ss)
            (setq ent (ssname ss i))
            (setq hnd (cdr (assoc 5 (entget ent))))
            (if (and hnd (not (member hnd *VL:COORD-ATTACHED-HANDLES*)))
              (progn
                (setq obj (vlax-ename->vla-object ent))
                ;; (vl:attach-coord-reactor obj)
                ;; (vl-catch-all-apply 'vl:refresh-coord-attrs (list obj))
              )
            )
            (setq i (1+ i))
          )
        )
      )
    )
  )
)

;; ------------------------------------------------------------
;; Callback реактора команд (:vlr-commandEnded / Cancelled / Failed).
;; Срабатывает ПОСЛЕ полного завершения команды — в этот момент
;; уведомления уже закончены, и менять объекты полностью безопасно.
;; Обрабатывает всё накопленное в *VL:COORD-DIRTY* и очищает список.
;; ------------------------------------------------------------
(defun vl:coord-cmd-ended (calling-reactor param-list / obj chk)
  (if *VL:COORD-DIRTY*
    (progn
      (foreach obj *VL:COORD-DIRTY*
        (setq chk (vl-catch-all-apply 'vla-get-ObjectName (list obj)))
        (if (not (vl-catch-all-error-p chk))
          (vl-catch-all-apply 'vl:refresh-coord-attrs (list obj))
        )
      )
      (setq *VL:COORD-DIRTY* '())
    )
  )
  (vl-catch-all-apply 'vl:auto-attach-new-coord-blocks nil)
)

;; --- Регистрирует реактор команд один раз за сеанс AutoCAD ---
(defun vl:ensure-coord-cmd-reactor ()
  (if (not *VL:COORD-CMD-REACTOR*)
    (setq *VL:COORD-CMD-REACTOR*
      (vlr-command-reactor
        nil
        (list
          (cons :vlr-commandEnded     'vl:coord-cmd-ended)
          (cons :vlr-commandCancelled 'vl:coord-cmd-ended)
          (cons :vlr-commandFailed    'vl:coord-cmd-ended)
        )
      )
    )
  )
)

;; --- Навешивает объектный реактор на один блок ---
(defun vl:attach-coord-reactor (blk-obj / hnd)
  (vl:ensure-coord-cmd-reactor)
  (setq hnd (vl-catch-all-apply 'vla-get-Handle (list blk-obj)))
  (if (not (vl-catch-all-error-p hnd))
    (setq *VL:COORD-ATTACHED-HANDLES* (cons hnd *VL:COORD-ATTACHED-HANDLES*))
  )
  (setq *VL:COORD-REACTORS*
    (cons
      (vlr-object-reactor (list blk-obj) nil (list (cons :vlr-modified 'vl:coord-block-modified)))
      *VL:COORD-REACTORS*
    )
  )
)

;; ------------------------------------------------------------
;; Команда: пере-навешивает реакторы на ВСЕ координатные блоки
;; в чертеже. Реакторы НЕ сохраняются в DWG между сеансами —
;; запускайте эту команду один раз после каждого открытия файла.
;; ------------------------------------------------------------
(defun c:REFRESHCOORDBLOCKS ( / ss i ent obj bname)
  (vl-load-com)
  (vl:ensure-coord-cmd-reactor)
  (setq bname (if *VL:COORD-BLOCK-NAME* *VL:COORD-BLOCK-NAME* "XY"))
  (setq *VL:COORD-REACTORS* '())
  (setq *VL:COORD-DIRTY* '())
  (setq *VL:COORD-ATTACHED-HANDLES* '())
  (setq ss (ssget "X" (list (cons 0 "INSERT") (cons 2 bname))))
  (setq i 0)
  (if ss
    (repeat (sslength ss)
      (setq ent (ssname ss i))
      (setq obj (vlax-ename->vla-object ent))
      ;; (vl:attach-coord-reactor obj)
      (setq i (1+ i))
    )
  )
  (princ (strcat "\n  Реакторы навешены на " (itoa i) " блок(ов) «" bname "»."))
  (princ)
)

