(defun vl:fmt-coord (val / sign abs-val int-part frac-part int-str frac-str)
  (setq sign (if (< val 0) "-" "+"))
  (setq abs-val (abs val))
  (setq int-part  (fix abs-val))
  (setq frac-part (fix (+ 0.5 (* (- abs-val int-part) 100))))
  (if (>= frac-part 100)
    (progn
      (setq int-part  (1+ int-part))
      (setq frac-part 0)
    )
  )
  (setq int-str  (itoa int-part))
  (setq frac-str (if (< frac-part 10)
                   (strcat "0" (itoa frac-part))
                   (itoa frac-part)))
  (strcat sign int-str "." frac-str)
)



(defun vl:fmt-length (val / abs-val int-part frac-part int-str frac-str)
  (setq abs-val (abs val))
  (setq int-part  (fix abs-val))
  (setq frac-part (fix (+ 0.5 (* (- abs-val int-part) 100))))
  (if (>= frac-part 100)
    (progn
      (setq int-part  (1+ int-part))
      (setq frac-part 0)
    )
  )
  (setq int-str  (itoa int-part))
  (setq frac-str (if (< frac-part 10)
                   (strcat "0" (itoa frac-part))
                   (itoa frac-part)))
  (strcat int-str "." frac-str)
)



(defun vl:mleader-style-exists-p (style-name / dict)
  (and
    (setq dict (dictsearch (namedobjdict) "ACAD_MLEADERSTYLE"))
    (dictsearch (cdr (assoc -1 dict)) style-name)
  )
)


;;; ------------------------------------------------------------
;;; Проверяет, существует ли размерный стиль (DIMSTYLE) с данным
;;; именем в текущем чертеже. Возвращает T или nil.
;;; ------------------------------------------------------------
(defun vl:dimstyle-exists-p (style-name / doc styles result)
  (vl-load-com)
  (setq doc    (vla-get-activedocument (vlax-get-acad-object)))
  (setq styles (vla-get-dimstyles doc))
  (setq result (vl-catch-all-apply 'vla-item (list styles style-name)))
  (not (vl-catch-all-error-p result))
)


;;; ------------------------------------------------------------
;;; Проверяет/создаёт текстовый стиль (обычный STYLE) с заданным
;;; именем. Возвращает имя стиля (строку).
;;; ------------------------------------------------------------
(defun vl:ensure-text-style (style-name / doc styles ts result)
  (vl-load-com)
  (setq doc    (vla-get-activedocument (vlax-get-acad-object)))
  (setq styles (vla-get-textstyles doc))
  (setq result (vl-catch-all-apply 'vla-item (list styles style-name)))
  (if (vl-catch-all-error-p result)
    (progn
      (setq ts (vla-add styles style-name))
      (vl-catch-all-apply '(lambda () (vla-put-fontfile ts "arial.ttf")))
    )
  )
  style-name
)

;;; ------------------------------------------------------------
;;; Проверяет, является ли полилиния замкнутой.
;;; Работает через ActiveX-свойство Closed (LWPOLYLINE / POLYLINE).
;;;
;;; ВАЖНО: vla-get-Closed возвращает не T/nil, а символы
;;; :vlax-true / :vlax-false. :vlax-false НЕ равен nil, поэтому
;;; его нельзя использовать в (if ...) напрямую — нужно явное
;;; сравнение с :vlax-true.
;;; ------------------------------------------------------------
(defun vl:polyline-closed-p (ename / obj result)
  (vl-load-com)
  (setq obj (vlax-ename->vla-object ename))
  (setq result (vl-catch-all-apply 'vla-get-Closed (list obj)))
  (if (vl-catch-all-error-p result)
    nil
    (= result :vlax-true)
  )
)

;;; ------------------------------------------------------------
;;; Автоматически подтягивает стиль мультивыноски из чертежа-
;;; шаблона, если стиля нет в текущем чертеже (через вставку
;;; шаблона как временного блока с последующим удалением).
;;;
;;; Возвращает T, если стиль есть в чертеже, и nil в противном случае.
;;; ------------------------------------------------------------
(defun vl:ensure-mleader-style-from-template (template-path mleader-style
                                               / old-filedia old-cmdecho old-osmode)
  (if (vl:mleader-style-exists-p mleader-style)
    T
    (if (not (findfile template-path))
      (progn
        (princ (strcat "\n  ПРЕДУПРЕЖДЕНИЕ: файл шаблона не найден: " template-path))
        (princ "\n  Создайте style_template.dwg с настроенным стилем «Координаты»")
        (princ "\n  и укажите верный путь в переменной template-path.")
        nil
      )
      (progn
        (setq old-filedia (getvar "FILEDIA"))
        (setq old-cmdecho (getvar "CMDECHO"))
        (setq old-osmode  (getvar "OSMODE"))
        (setvar "FILEDIA" 0)
        (setvar "CMDECHO" 0)
        (setvar "OSMODE"  0)

        ;; Перед INSERT — если блок с таким именем уже "болтается" в таблице
        ;; блоков (осталось от прошлой вставки шаблона), убираем его,
        ;; чтобы -INSERT не переспрашивал "переопределить?"
        (setq tmpl-block-name (vl-filename-base template-path))
        (if (tblsearch "BLOCK" tmpl-block-name)
          (command "_.-PURGE" "_B" tmpl-block-name "_N")
        )

        (command "_.-INSERT" template-path "_S" 1.0 "0,0,0" 0.0)
        (while (> (getvar "CMDACTIVE") 0) (command ""))
        (command "_.ERASE" "_L" "")
        (while (> (getvar "CMDACTIVE") 0) (command ""))

        (setvar "FILEDIA" old-filedia)
        (setvar "CMDECHO" old-cmdecho)
        (setvar "OSMODE"  old-osmode)

        (if (vl:mleader-style-exists-p mleader-style)
          T
          (progn
            (princ (strcat "\n  ПРЕДУПРЕЖДЕНИЕ: импорт не удался, стиль «"
                           mleader-style "» не появился в чертеже."))
            nil
          )
        )
      )
    )
  )
)


;;; ------------------------------------------------------------
;;; Индекс строки в списке без учёта регистра (0, если не найдена).
;;; ------------------------------------------------------------
(defun vl:index-of-ci (str lst / i res)
  (setq i 0 res nil)
  (while (and lst (not res))
    (if (= (strcase (car lst)) (strcase str)) (setq res i))
    (setq lst (cdr lst) i (1+ i))
  )
  (if res res 0)
)

;;; ------------------------------------------------------------
;;; Список имён размерных стилей из файла-шаблона (через ObjectDBX,
;;; без импорта в чертёж). Если ObjectDBX недоступен — встроенный
;;; список *VL:TEMPLATE-DIMSTYLES*.
;;; ------------------------------------------------------------
(defun vl:template-dimstyle-names (path / dbx res names nm)
  (setq names nil)
  (if (findfile path)
    (progn
      (setq res
        (vl-catch-all-apply
          '(lambda ()
             (setq dbx (vla-getinterfaceobject
                         (vlax-get-acad-object)
                         (strcat "ObjectDBX.AxDbDocument."
                                 (substr (getvar "ACADVER") 1 2))))
             (vla-open dbx path)
             (vlax-for s (vla-get-dimstyles dbx)
               (setq nm (vla-get-name s))
               (if (/= (substr nm 1 1) "*")
                 (setq names (cons nm names))
               )
             )
           )
        )
      )
      (if (and dbx (not (vlax-object-released-p dbx)))
        (vl-catch-all-apply 'vlax-release-object (list dbx))
      )
      (if (vl-catch-all-error-p res) (setq names nil))
    )
  )
  (if names (reverse names) *VL:TEMPLATE-DIMSTYLES*)
)

;;; ------------------------------------------------------------
;;; Диалог выбора размерных стилей. Возвращает (стиль-сторон
;;; стиль-М-линий) или nil при отмене. Последний выбор запоминается.
;;; ------------------------------------------------------------
(defun vl:pick-dimstyles (template-path def1 def2 single
                          / names i1 i2 dclpath f id res)
  (setq names (vl:template-dimstyle-names template-path))
  (if single
    (if *VL:PRIV-DIM-CHOICE* (setq def1 *VL:PRIV-DIM-CHOICE*))
    (if *VL:DIM-CHOICE*
      (setq def1 (car *VL:DIM-CHOICE*) def2 (cadr *VL:DIM-CHOICE*))
    )
  )
  (setq i1 (vl:index-of-ci def1 names))
  (setq i2 (vl:index-of-ci def2 names))

  (setq dclpath (strcat (getenv "TEMP") "\\vl_dimstyle_pick.dcl"))
  (setq f (open dclpath "w"))
  (write-line "vl_dimstyle : dialog {" f)
  (write-line "  label = \"Выбор размерных стилей\";" f)
  (write-line "  : popup_list { key = \"ds1\"; label = \"Размеры сторон:\"; edit_width = 36; }" f)
  (if (not single)
    (write-line "  : popup_list { key = \"ds2\"; label = \"Длина М-линий:\"; edit_width = 36; }" f)
  )
  (write-line "  ok_cancel;" f)
  (write-line "}" f)
  (close f)

  (setq id (load_dialog dclpath))
  (cond
    ((and (> id 0) (new_dialog "vl_dimstyle" id))
     (start_list "ds1") (mapcar 'add_list names) (end_list)
     (if (not single)
       (progn (start_list "ds2") (mapcar 'add_list names) (end_list))
     )
     (set_tile "ds1" (itoa i1))
     (if (not single) (set_tile "ds2" (itoa i2)))
     (action_tile "accept"
       (if single
         "(setq i1 (atoi (get_tile \"ds1\"))) (done_dialog 1)"
         "(setq i1 (atoi (get_tile \"ds1\")) i2 (atoi (get_tile \"ds2\"))) (done_dialog 1)"))
     (action_tile "cancel" "(done_dialog 0)")
     (setq res (start_dialog))
     (unload_dialog id)
     (vl-file-delete dclpath)
     (cond
       ((/= res 1) nil)
       (single
        (setq *VL:PRIV-DIM-CHOICE* (nth i1 names))
        (list *VL:PRIV-DIM-CHOICE* def2))
       (T (setq *VL:DIM-CHOICE* (list (nth i1 names) (nth i2 names))))
     )
    )
    (T
     (princ "\n  Не удалось открыть диалог — использую стили по умолчанию.")
     (list def1 def2)
    )
  )
)


;;; ------------------------------------------------------------
;;; Автоматически подтягивает размерный стиль (DIMSTYLE) из чертежа-
;;; шаблона, если стиля нет в текущем чертеже — тем же способом,
;;; что и стиль мультивыноски: вставка шаблона как временного блока
;;; с последующим удалением.
;;;
;;; Возвращает T, если стиль есть в чертеже, и nil в противном случае.
;;; ------------------------------------------------------------
;;; ------------------------------------------------------------
;;; Принудительно ставит размещение текста "Под линией" (DIMTAD = 4)
;;; для указанного размерного стиля.
;;; ------------------------------------------------------------
(defun vl:force-dimstyle-text-below (style-name / doc styles style old-cmdecho)
  (if (and style-name (vl:dimstyle-exists-p style-name))
    (progn
      (vl-load-com)
      (setq doc    (vla-get-ActiveDocument (vlax-get-acad-object)))
      (setq styles (vla-get-DimStyles doc))
      (setq style  (vl-catch-all-apply 'vla-Item (list styles style-name)))
      (if (not (vl-catch-all-error-p style))
        (progn
          ;; tekst pod liniey
          (vl-catch-all-apply 'vla-SetVariable (list style "DIMTAD" 4))
          ;; ubiraem prefix/suffix stilya, chtoby ne dublrovalos s TextOverride
          (vl-catch-all-apply 'vla-SetVariable (list style "DIMPOST" ""))
          (setq old-cmdecho (getvar "CMDECHO"))
          (setvar "CMDECHO" 0)
          (vl-catch-all-apply
            '(lambda ()
               (command "_.-DIMSTYLE" "_R" style-name)
               (setvar "DIMTAD" 4)
               (setvar "DIMPOST" "")
               (command "_.-DIMSTYLE" "_S" style-name "_Y")
             )
          )
          (setvar "CMDECHO" old-cmdecho)
        )
      )
    )
  )
  style-name
)

