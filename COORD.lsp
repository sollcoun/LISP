(defun vl:grid-add (grid item minx miny maxx maxy cell / ix ix1 iy iy0 iy1 key old)
  (setq ix  (fix (/ minx cell))
        ix1 (fix (/ maxx cell))
        iy0 (fix (/ miny cell))
        iy1 (fix (/ maxy cell)))
  (while (<= ix ix1)
    (setq iy iy0)
    (while (<= iy iy1)
      (setq key (cons ix iy))
      (setq old (assoc key grid))
      (if old
        (setq grid (subst (cons key (cons item (cdr old))) old grid))
        (setq grid (cons (cons key (list item)) grid))
      )
      (setq iy (1+ iy))
    )
    (setq ix (1+ ix))
  )
  grid
)

(defun vl:grid-query (grid minx miny maxx maxy cell / ix ix1 iy iy0 iy1 row acc b)
  (setq acc nil
        ix  (fix (/ minx cell))
        ix1 (fix (/ maxx cell))
        iy0 (fix (/ miny cell))
        iy1 (fix (/ maxy cell)))
  (while (<= ix ix1)
    (setq iy iy0)
    (while (<= iy iy1)
      (setq row (cdr (assoc (cons ix iy) grid)))
      (foreach b row
        (if (not (member b acc))
          (setq acc (cons b acc))
        )
      )
      (setq iy (1+ iy))
    )
    (setq ix (1+ ix))
  )
  acc
)

(defun vl:grid-add-bbox (grid bbox cell)
  (vl:grid-add grid bbox (nth 0 bbox) (nth 1 bbox) (nth 2 bbox) (nth 3 bbox) cell)
)

(defun vl:grid-add-seg (grid rec cell / p1 p2 minx maxx miny maxy)
  (setq p1 (cadr rec) p2 (caddr rec))
  (setq minx (min (car p1) (car p2))
        maxx (max (car p1) (car p2))
        miny (min (cadr p1) (cadr p2))
        maxy (max (cadr p1) (cadr p2)))
  (vl:grid-add grid rec minx miny maxx maxy cell)
)

(defun vl:build-seg-grid (vertices seg-count closed cell / grid i rest p1 p2)
  (setq grid nil i 0 rest vertices)
  (repeat seg-count
    (setq p1 (car rest)
          p2 (cadr rest)
          rest (cdr rest))
    (if (and p1 p2)
      (setq grid (vl:grid-add-seg grid (list i p1 p2 nil) cell))
    )
    (setq i (1+ i))
  )
  (if (and closed (car vertices) (nth seg-count vertices))
    (setq grid
      (vl:grid-add-seg grid
        (list seg-count (nth seg-count vertices) (car vertices) T)
        cell))
  )
  grid
)

(defun vl:ensure-seg-grid (vertices seg-count closed / )
  (if (not (and (eq *VL:SEG-GRID-SRC* vertices)
                (eq *VL:SEG-GRID-CLOSED* closed)
                (= *VL:SEG-GRID-COUNT* seg-count)))
    (progn
      (setq *VL:SEG-GRID* (vl:build-seg-grid vertices seg-count closed *VL:GRID-CELL*))
      (setq *VL:SEG-GRID-SRC* vertices)
      (setq *VL:SEG-GRID-CLOSED* closed)
      (setq *VL:SEG-GRID-COUNT* seg-count)
      (setq *VL:ORIENT-SIGN* (vl:polygon-orientation-sign vertices seg-count closed))
    )
  )
  *VL:SEG-GRID*
)

(defun vl:find-label-placement (vertex-pt label-w label-h vertices seg-count base-radius vertex-idx closed
                                 / angles radii found best-pt cand cbbox ok
                                   outward-ang sorted-angles
                                   pad dogleg text-left text-right text-bot text-top
                                   rad ang ri rn ai an hits rec seg-i p1 p2 cell)

  ;; Текст ставится справа от точки приземления на длину dogleg.
  ;; Кандидаты идут от направления «наружу». Первый свободный — результат.
  (setq dogleg base-radius)
  (setq pad (* label-h 0.35))
  (setq cell *VL:GRID-CELL*)
  (if (or (null cell) (<= cell 1e-6)) (setq cell 30.0))

  (vl:ensure-seg-grid vertices seg-count closed)
  (setq outward-ang
    (vl:outward-angle vertices seg-count vertex-idx closed *VL:ORIENT-SIGN*))
  (if (null outward-ang) (setq outward-ang 0.0))

  (setq angles '(0 15 30 45 60 75 90 105 120 135 150 165 180
                 195 210 225 240 255 270 285 300 315 330 345))
  (setq sorted-angles (vl:sort-angles-by-target angles outward-ang))

  (setq radii (list (* base-radius 3.0)
                    (* base-radius 5.0)
                    (* base-radius 7.5)
                    (* base-radius 11.0)
                    (* base-radius 16.0)
                    (* base-radius 22.0)
                    (* base-radius 30.0)))

  (setq found nil
        ri 0
        rn (length radii)
        an (length sorted-angles))

  (while (and (not found) (< ri rn))
    (setq rad (nth ri radii)
          ai 0)
    (while (and (not found) (< ai an))
      (setq ang (nth ai sorted-angles))
      (setq cand (vl:candidate-point vertex-pt ang rad))

      (setq text-left  (+ (car cand) dogleg))
      (setq text-right (+ text-left label-w))
      (setq text-bot   (- (cadr cand) (/ label-h 2.0)))
      (setq text-top   (+ (cadr cand) (/ label-h 2.0)))
      (setq cbbox (list (- text-left pad)
                        (- text-bot pad)
                        (+ text-right pad)
                        (+ text-top pad)))

      (setq ok T)

      ;; уже поставленные подписи — только ячейки этого бокса
      (setq hits (vl:grid-query *VL:LABEL-GRID*
                   (nth 0 cbbox) (nth 1 cbbox) (nth 2 cbbox) (nth 3 cbbox) cell))
      (while (and ok hits)
        (if (vl:bbox-overlap-p cbbox (car hits))
          (setq ok nil)
        )
        (setq hits (cdr hits))
      )

      ;; сегменты полилинии — только ячейки этого бокса
      (if ok
        (setq hits (vl:grid-query *VL:SEG-GRID*
                     (nth 0 cbbox) (nth 1 cbbox) (nth 2 cbbox) (nth 3 cbbox) cell))
      )
      (while (and ok hits)
        (setq rec (car hits)
              hits (cdr hits)
              seg-i (car rec)
              p1 (cadr rec)
              p2 (caddr rec))
        (if (or (= seg-i (1- vertex-idx))
                (= seg-i vertex-idx)
                (and (cadddr rec)
                     (or (= vertex-idx 0) (= vertex-idx seg-count))))
          (if (vl:bbox-seg-intersect-line-only-p cbbox p1 p2) (setq ok nil))
          (if (vl:bbox-seg-intersect-p cbbox p1 p2) (setq ok nil))
        )
      )

      (if ok
        (progn
          (setq best-pt cand)
          (setq found T)
        )
      )
      (setq ai (1+ ai))
    )
    (setq ri (1+ ri))
  )

  (if (not found)
    (setq best-pt (vl:candidate-point vertex-pt
                    (if outward-ang outward-ang 0.0)
                    (* base-radius 25.0)))
  )

  (setq text-left  (+ (car best-pt) dogleg))
  (setq text-right (+ text-left label-w))
  (setq text-bot   (- (cadr best-pt) (/ label-h 2.0)))
  (setq text-top   (+ (cadr best-pt) (/ label-h 2.0)))
  (setq cbbox (list (- text-left pad)
                    (- text-bot pad)
                    (+ text-right pad)
                    (+ text-top pad)))

  (setq *VL:PLACED-BBOXES* (cons cbbox *VL:PLACED-BBOXES*))
  (setq *VL:LABEL-GRID* (vl:grid-add-bbox *VL:LABEL-GRID* cbbox cell))

  best-pt
)

(if (not (boundp '*VL:COORD-MASTER-ENAME*)) (setq *VL:COORD-MASTER-ENAME* nil))
(if (not (boundp '*VL:COORD-MASTER-PT*))    (setq *VL:COORD-MASTER-PT* nil))

(defun vl:insert-coord-block (pt-vertex block-name x-str y-str scale txt-height rot-ang
                               / acadobj mspace blk-ref atts att tag
                                 props prop pname old-attreq old-attdia old-cmdecho old-osmode
                                 master-valid entget-result)
  (vl-load-com)
  (setq acadobj (vlax-get-acad-object))
  (setq mspace  (vla-get-modelspace (vla-get-activedocument acadobj)))

  (setq old-attreq  (getvar "ATTREQ"))
  (setq old-attdia  (getvar "ATTDIA"))
  (setq old-cmdecho (getvar "CMDECHO"))
  (setq old-osmode  (getvar "OSMODE"))
  (setvar "ATTREQ"  0)
  (setvar "ATTDIA"  0)
  (setvar "CMDECHO" 0)
  (setvar "OSMODE"  0)

  (setq entget-result
    (if *VL:COORD-MASTER-ENAME*
      (vl-catch-all-apply 'entget (list *VL:COORD-MASTER-ENAME*))
      nil
    )
  )
  (setq master-valid
    (and *VL:COORD-MASTER-ENAME*
         (not (vl-catch-all-error-p entget-result))
         entget-result
    )
  )

  (if master-valid
    ;; --- Копируем уже РАБОТАЮЩИЙ экземпляр (одиночное копирование,
    ;; завершается само после второй точки — лишний "" не нужен) ---
    (progn
      (command "_.COPY" *VL:COORD-MASTER-ENAME* ""
               *VL:COORD-MASTER-PT*
               pt-vertex)
      (while (> (getvar "CMDACTIVE") 0) (command ""))
      (setq blk-ref (vl-catch-all-apply 'vlax-ename->vla-object (list (entlast))))
    )
    ;; --- Самый первый экземпляр — создаём командой INSERT ---
    (progn
      (command "_.-INSERT" block-name pt-vertex scale scale rot-ang)
      (while (> (getvar "CMDACTIVE") 0) (command ""))
      (setq blk-ref (vl-catch-all-apply 'vlax-ename->vla-object (list (entlast))))
      (if (not (vl-catch-all-error-p blk-ref))
        (progn
          (setq *VL:COORD-MASTER-ENAME* (vlax-vla-object->ename blk-ref))
          (setq *VL:COORD-MASTER-PT*    pt-vertex)
        )
      )
    )
  )

  (setvar "ATTREQ"  old-attreq)
  (setvar "ATTDIA"  old-attdia)
  (setvar "CMDECHO" old-cmdecho)
  (setvar "OSMODE"  old-osmode)

  (if (or (vl-catch-all-error-p blk-ref) (null blk-ref))
    (progn
      (princ (strcat "\n  ОШИБКА: не удалось создать/скопировать блок «" block-name "»."))
      nil
    )
    (progn
      (vl-catch-all-apply '(lambda () (vla-put-XScaleFactor blk-ref scale)))
      (vl-catch-all-apply '(lambda () (vla-put-YScaleFactor blk-ref scale)))
      (vl-catch-all-apply '(lambda () (vla-put-ZScaleFactor blk-ref scale)))
      (vl-catch-all-apply '(lambda () (vla-put-Rotation blk-ref rot-ang)))

      (setq atts (vl-catch-all-apply 'vlax-invoke (list blk-ref 'GetAttributes)))
      (if (vl-catch-all-error-p atts) (setq atts nil))

      (if (and atts (> (length atts) 0))
        (progn
          (foreach att atts
            (setq tag (strcase (vla-get-TagString att)))
            (if (not (member tag '("X" "Х" "Y" "У")))
              (princ (strcat "\n    [диагностика] тег «" tag "» не распознан."))
            )
            (if (> scale 1e-9)
              (vl-catch-all-apply
                '(lambda () (vla-put-Height att (/ txt-height scale)))
              )
            )
            (vl-catch-all-apply '(lambda () (vla-put-Rotation att 0.0)))
          )
          (vla-Update blk-ref)

          (setq props
            (vl-catch-all-apply 'vlax-invoke (list blk-ref 'GetDynamicBlockProperties))
          )
          (if (not (vl-catch-all-error-p props))
            (foreach prop props
              (setq pname (vla-get-PropertyName prop))
              (if (or (= pname "Расстояние1")
                      (= pname "Distance1")
                      (wcmatch pname "*асстояние*")
                      (wcmatch pname "*istance*"))
                (vl-catch-all-apply '(lambda () (vla-put-Value prop 6.7ф)))
              )
            )
          )
         (vla-Update blk-ref)

          (setq *VL:COORD-BLOCK-NAME* block-name)
        )
        (princ (strcat "\n  ПРЕДУПРЕЖДЕНИЕ: нет атрибутов у блока «" block-name "»."))
      )

      ;; --- Выносим блок на передний план (поверх штриховок/подложки) ---
      (command "_.DRAWORDER" (vlax-vla-object->ename blk-ref) "" "_Front")
      (while (> (getvar "CMDACTIVE") 0) (command ""))



      (vlax-vla-object->ename blk-ref)
    )
  )
)
;;; ------------------------------------------------------------
;;; Всем объектам, созданным после last0, назначает слой и цвет
;;; полилинии poly-ename.
;;; ------------------------------------------------------------
(defun vl:apply-poly-props (last0 poly-ename / poly-obj lay tc e obj)
  (vl-load-com)
  (setq poly-obj (vlax-ename->vla-object poly-ename))
  (setq lay (vla-get-Layer poly-obj))
  (setq tc  (vl-catch-all-apply 'vla-get-TrueColor (list poly-obj)))
  (setq e (if last0 (entnext last0) (entnext)))
  (while e
    (setq obj (vl-catch-all-apply 'vlax-ename->vla-object (list e)))
    (if (not (vl-catch-all-error-p obj))
      (progn
        (vl-catch-all-apply 'vla-put-Layer (list obj lay))
        (if (not (vl-catch-all-error-p tc))
          (vl-catch-all-apply 'vla-put-TrueColor (list obj tc))
        )
      )
    )
    (setq e (entnext e))
  )
  (princ)
)


;;; ------------------------------------------------------------
;;; Точки вершин, где УЖЕ стоит координатная метка: вершины линий
;;; мультивыносок и точки вставки блока block-name (в модели).
;;; Возвращает список (x y).
;;; ------------------------------------------------------------
(defun vl:collect-existing-coord-pts (block-name / res ss i ed g inlead p obj en)
  (setq res '())

  ;; --- Мультивыноски: точки линий выноски из DXF-данных (LEADER_LINE) ---
  (if (setq ss (ssget "_X" '((0 . "MULTILEADER") (410 . "Model"))))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq ed (entget (ssname ss i)))
        (setq inlead nil)
        (foreach g ed
          (cond
            ((and (= (car g) 304) (= (cdr g) "LEADER_LINE{"))
             (setq inlead T))
            ((and (= (car g) 305) (= (cdr g) "}"))
             (setq inlead nil))
            ((and inlead (= (car g) 10))
             (setq res (cons (list (cadr g) (caddr g)) res)))
          )
        )
        (setq i (1+ i))
      )
    )
  )

  ;; --- Блоки координат ---
  ;; динамический блок после изменения свойств превращается в *U..,
  ;; поэтому сверяем действительное имя (EffectiveName)
  (if (setq ss (ssget "_X" (list '(0 . "INSERT") '(410 . "Model")
                                 (cons 2 (strcat block-name ",`*U*")))))
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq obj (vlax-ename->vla-object (ssname ss i)))
        (setq en  (vl-catch-all-apply 'vla-get-EffectiveName (list obj)))
        (if (and (= (type en) 'STR)
                 (= (strcase en) (strcase block-name)))
          (progn
            (setq p (cdr (assoc 10 (entget (ssname ss i)))))
            (setq res (cons (list (car p) (cadr p)) res))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  res
)

;;; T, если точка pt (по X и Y) совпадает с одной из точек списка.
(defun vl:pt-in-list-p (pt lst tol / found)
  (setq found nil)
  (while (and lst (not found))
    (if (and (< (abs (- (car pt) (car (car lst)))) tol)
             (< (abs (- (cadr pt) (cadr (car lst)))) tol))
      (setq found T)
    )
    (setq lst (cdr lst))
  )
  found
)

;;; ------------------------------------------------------------
;;; Извлекает список вершин из полилинии (LWPOLYLINE или
;;; 2D/3D POLYLINE). Возвращает список точек в формате (x y z).
;;; ------------------------------------------------------------
(defun vl:get-polyline-vertices (ename / etype vlist vertex-pt)
  (setq etype (cdr (assoc 0 (entget ename))))
  (cond
    ((= etype "LWPOLYLINE")
     (setq vlist '())
     (foreach pair (entget ename)
       (if (= (car pair) 10)
         (setq vlist (append vlist (list (list (cadr pair) (caddr pair) 0.0))))
       )
     )
     vlist
    )
    ((or (= etype "POLYLINE") (= etype "3DPOLYLINE"))
     (setq vlist '())
     (setq vertex-pt (entnext ename))
     (while (and vertex-pt
                 (= (cdr (assoc 0 (entget vertex-pt))) "VERTEX"))
       (setq vlist
         (append vlist (list (cdr (assoc 10 (entget vertex-pt)))))
       )
       (setq vertex-pt (entnext vertex-pt))
     )
     vlist
    )
    (T
     (princ (strcat "\n  ОШИБКА: объект не является полилинией (тип: " etype ")."))
     nil
    )
  )
)

;;; ------------------------------------------------------------
;;; Возвращает высоту текста из системной переменной TEXTSIZE.
;;; Если равна 0 — возвращает разумный дефолт 2.5.
;;; ------------------------------------------------------------
(defun vl:get-text-height (/ h)
  (setq h (getvar "TEXTSIZE"))
  (if (or (null h) (<= h 0.0))
    2.5
    h
  )
)

;;; ------------------------------------------------------------
;;; Экспортирует таблицу координат в CSV-файл (открывается в Excel).
;;; Разделитель ";" — корректно распознаётся Excel с русской локалью.
;;;
;;; Аргумент data-list — список записей вида (idx x-str y-str)
;;; ------------------------------------------------------------
(defun vl:export-csv (data-list csv-path / f row)
  (setq f (open csv-path "w"))
  (if (null f)
    (progn
      (princ (strcat "\n  ОШИБКА: не удалось создать файл " csv-path))
      nil
    )
    (progn
      (write-line "№;X;Y" f)
      (foreach row data-list
        (write-line
          (strcat (itoa (car row)) ";" (cadr row) ";" (caddr row))
          f
        )
      )
      (close f)
      (princ (strcat "\n  Файл CSV сохранён: " csv-path))
      T
    )
  )
)

;;; ------------------------------------------------------------
;;; Экспортирует таблицу координат в RTF-файл с настоящей таблицей
;;; (открывается в Word без COM-автоматизации).
;;;
;;; Аргумент data-list — список записей вида (idx x-str y-str)
;;; ------------------------------------------------------------
(defun vl:export-rtf (data-list rtf-path / f row col1 col2 col3 row-def)
  (setq f (open rtf-path "w"))
  (if (null f)
    (progn
      (princ (strcat "\n  ОШИБКА: не удалось создать файл " rtf-path))
      nil
    )
    (progn
      (setq col1 1200)
      (setq col2 3600)
      (setq col3 6000)

      (setq row-def
        (strcat
          "\\trowd\\trgaph108\\trleft0"
          "\\clbrdrt\\brdrs\\brdrw10\\clbrdrl\\brdrs\\brdrw10"
          "\\clbrdrb\\brdrs\\brdrw10\\clbrdrr\\brdrs\\brdrw10\\cellx" (itoa col1)
          "\\clbrdrt\\brdrs\\brdrw10\\clbrdrl\\brdrs\\brdrw10"
          "\\clbrdrb\\brdrs\\brdrw10\\clbrdrr\\brdrs\\brdrw10\\cellx" (itoa col2)
          "\\clbrdrt\\brdrs\\brdrw10\\clbrdrl\\brdrs\\brdrw10"
          "\\clbrdrb\\brdrs\\brdrw10\\clbrdrr\\brdrs\\brdrw10\\cellx" (itoa col3)
        )
      )

      (write-line "{\\rtf1\\ansi\\ansicpg1251\\deff0" f)
      (write-line "{\\fonttbl{\\f0 Arial;}}" f)
      (write-line "\\f0\\fs24" f)
      (write-line "{\\b Таблица координат вершин полилинии}\\par\\par" f)

      (write-line row-def f)
      (write-line "\\intbl\\qc\\b №\\cell\\qc X\\cell\\qc Y\\cell\\row\\b0" f)

      (foreach row data-list
        (write-line row-def f)
        (write-line
          (strcat
            "\\intbl\\qc " (itoa (car row)) "\\cell"
            "\\qc " (cadr row) "\\cell"
            "\\qc " (caddr row) "\\cell\\row"
          )
          f
        )
      )

      (write-line "}" f)
      (close f)
      (princ (strcat "\n  Файл RTF (Word) сохранён: " rtf-path))
      T
    )
  )
)

;;; ------------------------------------------------------------
;;; Запрашивает у пользователя, нужно ли экспортировать таблицу
;;; координат, и в каком формате (Excel / Word / Оба / Нет).
;;;
;;; Аргумент data-list — список записей вида (idx x-str y-str)
;;; ------------------------------------------------------------
(defun vl:offer-export (data-list / choice base-path)
  (initget "Excel Word Оба Нет")
  (setq choice
    (getkword
      "\nЭкспортировать таблицу координат? [Excel/Word/Оба/Нет] <Нет>: "
    )
  )
  (if (null choice) (setq choice "Нет"))

  (cond
    ((= choice "Нет")
     (princ "\n  Экспорт пропущен.")
    )
    (T
     (setq base-path
       (getfiled "Укажите имя файла для экспорта" "координаты" "csv" 1)
     )
     (if (null base-path)
       (princ "\n  Экспорт отменён пользователем.")
       (progn
         (if (wcmatch (strcase base-path) "*.CSV")
           (setq base-path (substr base-path 1 (- (strlen base-path) 4)))
         )
         (cond
           ((= choice "Excel")
            (vl:export-csv data-list (strcat base-path ".csv"))
           )
           ((= choice "Word")
            (vl:export-rtf data-list (strcat base-path ".rtf"))
           )
           ((= choice "Оба")
            (vl:export-csv data-list (strcat base-path ".csv"))
            (vl:export-rtf data-list (strcat base-path ".rtf"))
           )
         )
       )
     )
    )
  )
)

;;; ------------------------------------------------------------
;;; Задаёт масштаб маски фона мультивыноски (DXF 141) —
;;; маска только у текста. Должна быть определена ДО
;;; vl:create-parallel-dim-with-label.
;;; ------------------------------------------------------------
(defun vl:set-mleader-mask-scale (ename scale / elst new)
  (if ename
    (progn
      (setq elst (entget ename '("*")))
      (if (assoc 141 elst)
        (progn
          (setq new (subst (cons 141 (float scale)) (assoc 141 elst) elst))
          (vl-catch-all-apply 'entmod (list new))
          (entupd ename)
        )
      )
    )
  )
  ename
)

;;; ------------------------------------------------------------
;;; Создаёт параллельный (aligned) размер между двумя точками
;;; с подписью — фактической длиной отрезка (vl:fmt-length).
;;; Длинный сегмент: подпись на размерной линии (<>).
;;; Короткий сегмент: подпись выноской с маской фона 1.05
;;; (маска только у текста).
;;;
;;; Возвращает: entity name размера / мультивыноски, либо nil.
;;; ------------------------------------------------------------
(defun vl:create-parallel-dim-with-label
       (pt1 pt2 offset-dist txt-height dim-style-name mleader-style-name dim-text-gap
        other-verts-list parallel-search-dist
        / acadobj mspace dx dy seg-len perp-x perp-y dim-pt mid-pt
          near-pt to-near-x to-near-y side-dot
          dim-obj length-str char-count required-width label-ename)

  (vl-load-com)
  (setq acadobj (vlax-get-acad-object))
  (setq mspace  (vla-get-modelspace (vla-get-activedocument acadobj)))

  ;; --- Вектор сегмента и его длина ---
  (setq dx (- (car pt2) (car pt1)))
  (setq dy (- (cadr pt2) (cadr pt1)))
  (setq seg-len (sqrt (+ (* dx dx) (* dy dy))))

  (if (< seg-len 1e-9)
    nil
    (progn
      ;; --- Перпендикуляр к сегменту ---
      (setq perp-x (/ (- dy) seg-len)
            perp-y (/ dx seg-len))

      (setq mid-pt
        (list (/ (+ (car pt1) (car pt2)) 2.0)
              (/ (+ (cadr pt1) (cadr pt2)) 2.0)
              0.0)
      )

      ;; --- Выбор стороны размера ---
      (setq near-pt
        (vl:nearest-pt-on-verts-list mid-pt other-verts-list parallel-search-dist)
      )
      (if near-pt
        (progn
          (setq to-near-x (- (car near-pt) (car mid-pt)))
          (setq to-near-y (- (cadr near-pt) (cadr mid-pt)))
          (setq side-dot (+ (* to-near-x perp-x) (* to-near-y perp-y)))
          (if (> side-dot 0.0)
            (setq perp-x (- perp-x)
                  perp-y (- perp-y))
          )
        )
        (if (> perp-y 0.0)
          (setq perp-x (- perp-x)
                perp-y (- perp-y))
        )
      )

      (setq dim-pt
        (list
          (+ (car mid-pt)  (* perp-x offset-dist))
          (+ (cadr mid-pt) (* perp-y offset-dist))
          0.0
        )
      )

      (if (not *VL:DIM-ON-LINE*) (setvar "DIMTAD" 4))
      (setq dim-obj
        (vl-catch-all-apply
          'vla-AddDimAligned
          (list mspace
                (vlax-3d-point pt1)
                (vlax-3d-point pt2)
                (vlax-3d-point dim-pt))
        )
      )

      (if (or (null dim-obj) (vl-catch-all-error-p dim-obj))
        (progn
          (princ "\n  ОШИБКА: не удалось создать параллельный размер.")
          nil
        )
        (progn
          (if dim-style-name
            (vl-catch-all-apply '(lambda () (vla-put-StyleName dim-obj dim-style-name)))
          )

          ;; --- Привязка: текст по центру линии, фон скрывает полилинию ---
          (if *VL:DIM-ON-LINE*
            (progn
              (vl-catch-all-apply '(lambda () (vla-put-VerticalTextPosition dim-obj 0)))
              (vl-catch-all-apply '(lambda () (vla-put-TextFill dim-obj :vlax-true)))
              (vl-catch-all-apply '(lambda () (vla-put-TextFillColor dim-obj 254)))
            )
          )

          ;; --- Оценка ширины текста ---
          (setq length-str     (vl:fmt-length seg-len))
          (setq char-count     (strlen length-str))
          (setq required-width (* char-count txt-height 0.6))

          (if (>= seg-len required-width)
            ;; --- Длинный сегмент: <> = живое значение AutoCAD ---
            (progn
              (vl-catch-all-apply '(lambda () (vla-put-TextOverride dim-obj "<>")))
              (setq label-ename (vlax-vla-object->ename dim-obj))
            )
            ;; --- Короткий сегмент: вынос (текст статичный) ---
            (progn
              (vl-catch-all-apply '(lambda () (vla-put-TextOverride dim-obj " ")))
              (setq label-ename
                (vl:create-mleader
                  mid-pt
                  (list (car mid-pt) (+ (cadr mid-pt) (* txt-height 2.0)) 0.0)
                  (list (+ (car mid-pt) (* txt-height 2.0))
                        (+ (cadr mid-pt) (* txt-height 2.0)) 0.0)
                  length-str
                  mleader-style-name
                  0.5
                  txt-height
                )
              )
              ;; маска 1.05 — только у текста выноски
              (if label-ename
                (vl:set-mleader-mask-scale label-ename 1.05)
              )
            )
          )
          label-ename
        )
      )
    )
  )
)

;;; ============================================================
;;; М-ЛИНИИ: поиск у полилинии и размер L=
;;; ============================================================

(defun vl:mline-verts (ename / obj coords verts n k pair)
  (setq verts '())
  (setq obj (vlax-ename->vla-object ename))
  (setq coords (vl-catch-all-apply 'vlax-get (list obj 'Coordinates)))
  (if (and (not (vl-catch-all-error-p coords))
           (listp coords)
           (numberp (car coords)))
    (progn
      (setq n (length coords) k 0)
      (while (< k n)
        (setq verts (cons (list (nth k coords) (nth (1+ k) coords) 0.0) verts))
        (setq k (+ k 3))
      )
      (setq verts (reverse verts))
    )
  )
  (if (or (null verts) (< (length verts) 2))
    (progn
      (setq verts '())
      (foreach pair (entget ename)
        (if (= (car pair) 11)
          (setq verts (cons (list (cadr pair) (caddr pair) 0.0) verts))
        )
      )
      (setq verts (reverse verts))
    )
  )
  verts
)

(defun vl:poly-len-2d (verts / i len)
  (setq len 0.0 i 0)
  (repeat (max 0 (1- (length verts)))
    (setq len (+ len (distance (nth i verts) (nth (1+ i) verts))))
    (setq i (1+ i))
  )
  len
)

(defun vl:dist-pt-poly-2d (pt verts / i va vb ax ay bx by px py abx aby ab2 param qx qy d mind)
  (setq mind 1e99 px (car pt) py (cadr pt) i 0)
  (repeat (max 0 (1- (length verts)))
    (setq va (nth i verts) vb (nth (1+ i) verts)
          ax (car va) ay (cadr va) bx (car vb) by (cadr vb)
          abx (- bx ax) aby (- by ay)
          ab2 (+ (* abx abx) (* aby aby)))
    (if (< ab2 1e-18)
      (setq d (distance pt va))
      (progn
        (setq param (/ (+ (* (- px ax) abx) (* (- py ay) aby)) ab2))
        (if (< param 0.0) (setq param 0.0))
        (if (> param 1.0) (setq param 1.0))
        (setq qx (+ ax (* param abx)) qy (+ ay (* param aby)))
        (setq d (distance pt (list qx qy 0.0)))
      )
    )
    (if (< d mind) (setq mind d))
    (setq i (1+ i))
  )
  mind
)

(defun vl:mline-near-segment-p (pt1 pt2 search-dist
                                 / ss-ml k ml-en ml-verts found mid-seg
                                   seg-dx seg-dy seg-len
                                   i va vb ml-dx ml-dy ml-seg-len
                                   d dotp len-diff)
  (setq found nil)
  (setq mid-seg (list (/ (+ (car pt1) (car pt2)) 2.0)
                       (/ (+ (cadr pt1) (cadr pt2)) 2.0)
                       0.0))
  (setq seg-dx (- (car pt2) (car pt1)))
  (setq seg-dy (- (cadr pt2) (cadr pt1)))
  (setq seg-len (sqrt (+ (* seg-dx seg-dx) (* seg-dy seg-dy))))

  (setq ss-ml (ssget "_X" '((0 . "MLINE"))))
  (if (and ss-ml (> seg-len 1e-9))
    (progn
      (setq k 0)
      (while (and (not found) (< k (sslength ss-ml)))
        (setq ml-en (ssname ss-ml k))
        (setq ml-verts (vl:mline-verts ml-en))
        (if (>= (length ml-verts) 2)
          (progn
            (setq i 0)
            (while (and (not found) (< i (1- (length ml-verts))))
              (setq va (nth i ml-verts)
                    vb (nth (1+ i) ml-verts)
                    ml-dx (- (car vb) (car va))
                    ml-dy (- (cadr vb) (cadr va))
                    ml-seg-len (distance va vb))
              (if (> ml-seg-len 1e-9)
                (progn
                  (setq d (vl:dist-pt-poly-2d mid-seg (list va vb)))
                  (setq dotp
                    (/ (abs (+ (* seg-dx ml-dx) (* seg-dy ml-dy)))
                       (* seg-len ml-seg-len)))
                  ;; близко + почти параллельно + почти та же длина
                  (if (and (<= d search-dist)
                           (>= dotp 0.9)
                           (<= (abs (- seg-len ml-seg-len)) 0.15))
                    (setq found T)
                  )
                )
              )
              (setq i (1+ i))
            )
          )
        )
        (setq k (1+ k))
      )
    )
  )
  found
)

(defun vl:nearest-seg-len-on-poly (pt verts / i va vb ax ay bx by px py abx aby ab2 param qx qy d mind best-len)
  (setq mind 1e99 best-len 0.0 px (car pt) py (cadr pt) i 0)
  (repeat (max 0 (1- (length verts)))
    (setq va (nth i verts) vb (nth (1+ i) verts)
          ax (car va) ay (cadr va) bx (car vb) by (cadr vb)
          abx (- bx ax) aby (- by ay)
          ab2 (+ (* abx abx) (* aby aby)))
    (if (< ab2 1e-18)
      (setq d (distance pt va))
      (progn
        (setq param (/ (+ (* (- px ax) abx) (* (- py ay) aby)) ab2))
        (if (< param 0.0) (setq param 0.0))
        (if (> param 1.0) (setq param 1.0))
        (setq qx (+ ax (* param abx)) qy (+ ay (* param aby)))
        (setq d (distance pt (list qx qy 0.0)))
      )
    )
    (if (< d mind) (progn (setq mind d) (setq best-len (distance va vb))))
    (setq i (1+ i))
  )
  best-len
)

;;; ------------------------------------------------------------
;;; Ближайшая точка на ОДНОЙ ломаной (список вершин) к точке pt.
;;; Возвращает точку (x y 0.0) либо nil, если verts пуст/вырожден.
;;; ------------------------------------------------------------
(defun vl:nearest-pt-on-verts (pt verts / i va vb ax ay bx by px py abx aby ab2 param qx qy d mind best)
  (setq mind 1e99 best nil px (car pt) py (cadr pt) i 0)
  (repeat (max 0 (1- (length verts)))
    (setq va (nth i verts) vb (nth (1+ i) verts)
          ax (car va) ay (cadr va) bx (car vb) by (cadr vb)
          abx (- bx ax) aby (- by ay)
          ab2 (+ (* abx abx) (* aby aby)))
    (if (< ab2 1e-18)
      (progn (setq qx ax qy ay) (setq d (distance pt va)))
      (progn
        (setq param (/ (+ (* (- px ax) abx) (* (- py ay) aby)) ab2))
        (if (< param 0.0) (setq param 0.0))
        (if (> param 1.0) (setq param 1.0))
        (setq qx (+ ax (* param abx)) qy (+ ay (* param aby)))
        (setq d (distance pt (list qx qy 0.0)))
      )
    )
    (if (< d mind) (progn (setq mind d) (setq best (list qx qy 0.0))))
    (setq i (1+ i))
  )
  best
)

;;; ------------------------------------------------------------
;;; Ближайшая точка среди СПИСКА ломаных (other-verts-list — список
;;; списков вершин) к точке pt, в пределах max-dist.
;;; Возвращает точку либо nil, если ничего не найдено в радиусе.
;;; ------------------------------------------------------------
(defun vl:nearest-pt-on-verts-list (pt verts-list max-dist / verts result best-d cand cd)
  (setq best-d max-dist result nil)
  (foreach verts verts-list
    (if (>= (length verts) 2)
      (progn
        (setq cand (vl:nearest-pt-on-verts pt verts))
        (if cand
          (progn
            (setq cd (distance pt cand))
            (if (< cd best-d) (progn (setq best-d cd) (setq result cand)))
          )
        )
      )
    )
  )
  result
)

(defun vl:add-mleader-simple (pt-arrow pt-text str txt-h style-name / mspace pts ml old-cmleaderstyle)
  (setq mspace (vla-get-ModelSpace
                 (vla-get-ActiveDocument (vlax-get-acad-object))))

  (setq old-cmleaderstyle (getvar "CMLEADERSTYLE"))
  (if (and style-name (vl:mleader-style-exists-p style-name))
    (vl-catch-all-apply 'setvar (list "CMLEADERSTYLE" style-name))
  )

  (setq pts (vlax-make-safearray vlax-vbDouble '(0 . 5)))
  (vlax-safearray-fill pts
    (list (car pt-arrow) (cadr pt-arrow) 0.0
          (car pt-text)  (cadr pt-text)  0.0))
  (setq ml (vl-catch-all-apply 'vla-AddMLeader (list mspace pts 0)))

  (setvar "CMLEADERSTYLE" old-cmleaderstyle)

  (if (vl-catch-all-error-p ml)
    nil
    (progn
      (vl-catch-all-apply '(lambda () (vla-put-StyleName ml style-name)))
      
      ;; точка на первой строке
      (vl-catch-all-apply '(lambda () (vla-put-TextString ml (strcat "." "\\P" str))))
      (vl-catch-all-apply '(lambda () (vla-put-TextHeight ml txt-h)))
      
      (vl-catch-all-apply '(lambda () (vla-put-EnableDogleg ml :vlax-true)))
      (vl-catch-all-apply '(lambda () (vla-put-ArrowheadType ml 20)))
      
      ;; горизонтальное + подчёркивание первой строки
      (vl-catch-all-apply '(lambda () (vla-put-TextAttachmentDirection ml 0)))
      (vl-catch-all-apply '(lambda () (vla-put-TextLeftAttachmentType  ml 3)))
      (vl-catch-all-apply '(lambda () (vla-put-TextRightAttachmentType ml 3)))
      (vl-catch-all-apply '(lambda () (vla-put-LandingGap ml 0.0)))
      
      ;; важно: отключаем автоматическое удлинение полки до текста
      (vl-catch-all-apply '(lambda () (vla-put-ExtendLeaderToText ml :vlax-false)))
      
      ;; маска фона
      (vl-catch-all-apply '(lambda () (vla-put-TextBackgroundFill ml :vlax-true)))
      (vl-catch-all-apply '(lambda () (vla-put-TextBackgroundColor ml 254)))
      (vl-catch-all-apply '(lambda () (vla-put-TextBackgroundScaleFactor ml 1.05)))
      (vl:set-mleader-mask-scale (vlax-vla-object->ename ml) 1.05)
      
      ;; ? САМОЕ ВАЖНОЕ: длину полки ставим в самом конце
      (vl-catch-all-apply '(lambda () (vla-put-DoglegLength ml 0.5)))
      
      ml
    )
  )
)


;;; --- Размеры всех М-линий рядом с полилинией ---
(defun vl:dim-mlines-near-polyline
       (pl-ename pl-verts search-dist txt-h dim-style-name mleader-style-name
                 mline-prefix already-dimmed
        / ss-ml j ml-en ml-verts d found-list
          mspace dim-obj txt need-w off
          i p1 p2 mid-ml len
          dx dy seg-len2 perp-x perp-y near-pt to-near-x to-near-y side-dot dim-pt txt-assoc)

  (setq found-list '())
  (setq search-dist (if search-dist search-dist 5.0))
  (setq txt-h (if txt-h txt-h 1.0))
  (setq off 2.0)
  (if (null mline-prefix) (setq mline-prefix "L="))

  (setq ss-ml (ssget "_X" '((0 . "MLINE"))))
  (if (null ss-ml)
    (princ "\n  MLINE не найдены.")
    (progn
      (setq j 0)
      (repeat (sslength ss-ml)
        (setq ml-en (ssname ss-ml j))
        (if (not (member ml-en already-dimmed))
          (progn
            (setq ml-verts (vl:mline-verts ml-en))
            (if (>= (length ml-verts) 2)
              (progn
                ;; проверяем, есть ли хотя бы одна вершина MLINE рядом с полилинией
                (setq d 1e99)
                (foreach p ml-verts
                  (setq d (min d (vl:dist-pt-poly-2d p pl-verts)))
                )
                (if (<= d search-dist)
                  (setq found-list (cons (list ml-en ml-verts) found-list))
                )
              )
            )
          )
        )
        (setq j (1+ j))
      )

      (if (null found-list)
        (princ (strcat "\n  Нет MLINE в пределах " (rtos search-dist 2 1) "."))
        (progn
          (setq mspace (vla-get-ModelSpace
                         (vla-get-ActiveDocument (vlax-get-acad-object))))
          (princ (strcat "\n  Обрабатываю MLINE: " (itoa (length found-list))))

          (foreach item found-list
            (setq ml-en    (car item)
                  ml-verts (cadr item))

            (setq already-dimmed (cons ml-en already-dimmed))

            ;; === ГЛАВНОЕ ИЗМЕНЕНИЕ: цикл по КАЖДОМУ сегменту MLINE ===
            (setq i 0)
            (repeat (1- (length ml-verts))
              (setq p1  (nth i ml-verts)
                    p2  (nth (1+ i) ml-verts)
                    len (distance p1 p2)
                    mid-ml (list (/ (+ (car p1) (car p2)) 2.0)
                                 (/ (+ (cadr p1) (cadr p2)) 2.0)
                                 0.0)
                    txt (strcat mline-prefix (vl:fmt-length len))
                    need-w (* (strlen txt) txt-h 0.6)
                    ;; associative override: L=<>  (updates when moved)
                    txt-assoc (strcat mline-prefix "<>"))

              ;; ставим размер только если сегмент действительно рядом с полилинией
              (if (<= (vl:dist-pt-poly-2d mid-ml pl-verts) search-dist)
                (progn
                  (setq dx (- (car p2) (car p1)))
                  (setq dy (- (cadr p2) (cadr p1)))
                  (setq seg-len2 (distance p1 p2))
                  (if (> seg-len2 1e-9)
                    (setq perp-x (/ (- dy) seg-len2) perp-y (/ dx seg-len2))
                    (setq perp-x 0.0 perp-y -1.0)
                  )

                  ;; выбираем сторону (от полилинии)
                  (setq near-pt (vl:nearest-pt-on-verts mid-ml pl-verts))
                  (if near-pt
                    (progn
                      (setq to-near-x (- (car near-pt) (car mid-ml)))
                      (setq to-near-y (- (cadr near-pt) (cadr mid-ml)))
                      (setq side-dot (+ (* to-near-x perp-x) (* to-near-y perp-y)))
                      (if (> side-dot 0.0)
                        (progn (setq perp-x (- perp-x)) (setq perp-y (- perp-y)))
                      )
                    )
                  )

                  (setq dim-pt
                    (list
                      (+ (car mid-ml) (* perp-x off))
                      (+ (cadr mid-ml) (* perp-y off))
                      0.0
                    )
                  )

                  ;; pered sozdaniem - DIMTAD=4 (pod liniey)
                  (setvar "DIMTAD" 4)
                  (setq dim-obj
                    (vla-AddDimAligned
                      mspace
                      (vlax-3d-point p1)
                      (vlax-3d-point p2)
                      (vlax-3d-point dim-pt)
                    )
                  )
                  (if dim-obj
                    (progn
                      (if dim-style-name
                        (vl-catch-all-apply
                          '(lambda () (vla-put-StyleName dim-obj dim-style-name)))
                      )
                      ;; prefix tolko cherez TextOverride (L=<> ili L-<>)
                      (if (>= len need-w)
                        (vl-catch-all-apply
                          '(lambda () (vla-put-TextOverride dim-obj txt-assoc)))
                        (progn
                          (vl-catch-all-apply
                            '(lambda () (vla-put-TextOverride dim-obj " ")))
                          (vl:add-mleader-simple
                            mid-ml
                            (list (+ (car mid-ml) (* perp-x txt-h 3.0))
                                  (+ (cadr mid-ml) (* perp-y txt-h 3.0))
                                  0.0)
                            txt
                            txt-h
                            mleader-style-name
                          )
                        )
                      )
                    )
                  )
                )
              )
              (setq i (1+ i))
            )
          )
        )
      )
    )
  )
  already-dimmed
)
;;; ============================================================
;;; ГЛАВНАЯ КОМАНДА: COORD
;;; ============================================================

;;; ============================================================
;;; Диалог настроек COORD (меньше кликов): одно окно вместо
;;; серии getkword. Запоминает последние значения в *VL:SETTINGS*.
;;; Возвращает assoc-список или nil при отмене.
;;; ============================================================
(defun vl:settings-get (key default / v)
  (setq v (if *VL:SETTINGS* (cdr (assoc key *VL:SETTINGS*)) nil))
  (if v v default)
)

(defun vl:settings-put (key val)
  (setq *VL:SETTINGS*
    (cons (cons key val)
          (vl-remove-if '(lambda (x) (= (car x) key)) *VL:SETTINGS*)))
)

(defun vl:settings-dialog (priv template-path def-dim def-mline
                           / names i-dim i-mline dclpath f id res
                             number-mode dim-mode mline-prefix output-mode
                             num-choice start-num continue-mode
                             do-export export-fmt only-export
                             has-continue cont-label
                             tile-num tile-dim tile-pref tile-out
                             tile-numch tile-start tile-cont
                             tile-ds1 tile-ds2 tile-exp tile-efmt
                             result)

  (setq names (vl:template-dimstyle-names template-path))
  (if (null names) (setq names (list "Standard")))

  ;; значения по умолчанию из прошлого запуска
  (setq number-mode   (vl:settings-get 'number-mode   (if priv "Нет" "Да")))
  (setq dim-mode      (vl:settings-get 'dim-mode      "Да"))
  (setq mline-prefix  (vl:settings-get 'mline-prefix  "L="))
  (setq output-mode   (vl:settings-get 'output-mode   "Мультивыноска"))
  (setq num-choice    (vl:settings-get 'num-choice    "Авто"))
  (setq start-num     (vl:settings-get 'start-num     "1"))
  (setq continue-mode (vl:settings-get 'continue-mode "Продолжить"))
  (setq do-export     (vl:settings-get 'do-export     "0"))
  (setq export-fmt    (vl:settings-get 'export-fmt    "Excel"))
  (setq only-export   (vl:settings-get 'only-export   "0"))

  (if priv (setq number-mode "Нет" dim-mode "Да"))

  ;; стили: из прошлого выбора или defaults
  (if *VL:DIM-CHOICE*
    (setq def-dim (car *VL:DIM-CHOICE*) def-mline (cadr *VL:DIM-CHOICE*))
  )
  (if (and priv *VL:PRIV-DIM-CHOICE*)
    (setq def-dim *VL:PRIV-DIM-CHOICE*)
  )
  (setq def-dim   (vl:settings-get 'dim-style       def-dim))
  (setq def-mline (vl:settings-get 'mline-dim-style def-mline))
  (setq i-dim   (vl:index-of-ci def-dim names))
  (setq i-mline (vl:index-of-ci def-mline names))

  (setq has-continue
    (and *VL:LAST-VERTEX-NUM* (> *VL:LAST-VERTEX-NUM* 0))
  )
  (setq cont-label
    (if has-continue
      (strcat "Продолжить с №" (itoa (1+ *VL:LAST-VERTEX-NUM*)) " / Заново")
      ""
    )
  )

  (setq dclpath (strcat (getenv "TEMP") "\\vl_coord_settings.dcl"))
  (setq f (open dclpath "w"))
  (write-line "vl_coord_settings : dialog {" f)
  (write-line (if priv
                "  label = \"ПРИВЯЗКА — настройки\";"
                "  label = \"COORD — настройки\";") f)
  (write-line "  spacer;" f)

  ;; --- Только экспорт ---
  (write-line "  : toggle { key = \"onlyexp\"; label = \"Только экспорт (без простановки номеров и размеров)\"; }" f)
  (write-line "  spacer;" f)

  ;; --- Номера / размеры ---
  (if (not priv)
    (progn
      (write-line "  : toggle { key = \"num\"; label = \"Проставлять номера вершин\"; }" f)
      (write-line "  : toggle { key = \"dim\"; label = \"Проставлять размеры сторон\"; }" f)
    )
    (write-line "  : text { label = \"Режим привязки: координаты + размеры (без номеров)\"; }" f)
  )

  (write-line "  spacer;" f)
  (write-line "  : popup_list { key = \"out\"; label = \"Способ вывода координат:\"; edit_width = 28; }" f)

  (if (not priv)
    (progn
      (write-line "  : popup_list { key = \"pref\"; label = \"Префикс длины М-линий:\"; edit_width = 12; }" f)
      (write-line "  spacer;" f)
      (write-line "  : popup_list { key = \"numch\"; label = \"Нумерация вершин:\"; edit_width = 28; }" f)
      (write-line "  : edit_box { key = \"start\"; label = \"Начальный номер:\"; edit_width = 8; }" f)
      (if has-continue
        (write-line (strcat "  : popup_list { key = \"cont\"; label = \"" cont-label ":\"; edit_width = 20; }") f)
      )
    )
  )

  (write-line "  spacer;" f)
  (write-line "  : popup_list { key = \"ds1\"; label = \"Стиль размеров сторон:\"; edit_width = 32; }" f)
  (if (not priv)
    (write-line "  : popup_list { key = \"ds2\"; label = \"Стиль размеров М-линий:\"; edit_width = 32; }" f)
  )

  (write-line "  spacer;" f)
  (write-line "  : toggle { key = \"exp\"; label = \"Экспортировать таблицу координат\"; }" f)
  (write-line "  : popup_list { key = \"efmt\"; label = \"Формат экспорта:\"; edit_width = 16; }" f)

  (write-line "  spacer;" f)
  (write-line "  ok_cancel;" f)
  (write-line "}" f)
  (close f)

  (setq id (load_dialog dclpath))
  (setq result nil)
  (cond
    ((and (> id 0) (new_dialog "vl_coord_settings" id))
     ;; --- заполнение списков ---
     (if (not priv)
       (progn
         (set_tile "num" (if (= number-mode "Да") "1" "0"))
         (set_tile "dim" (if (= dim-mode "Да") "1" "0"))
         (start_list "pref")
         (mapcar 'add_list (list "L=" "L-"))
         (end_list)
         (set_tile "pref" (if (= mline-prefix "L-") "1" "0"))
         (start_list "numch")
         (mapcar 'add_list (list "Авто" "Начальный номер точки"))
         (end_list)
         (set_tile "numch" (if (= num-choice "Начальный номер точки") "1" "0"))
         (set_tile "start" (if start-num start-num "1"))
         (if has-continue
           (progn
             (start_list "cont")
             (mapcar 'add_list (list "Продолжить" "Заново"))
             (end_list)
             (set_tile "cont" (if (= continue-mode "Заново") "1" "0"))
           )
         )
       )
     )

     (start_list "out")
     (mapcar 'add_list (list "Мультивыноска" "Блок"))
     (end_list)
     (set_tile "out" (if (= output-mode "Блок") "1" "0"))

     (start_list "ds1") (mapcar 'add_list names) (end_list)
     (set_tile "ds1" (itoa i-dim))
     (if (not priv)
       (progn
         (start_list "ds2") (mapcar 'add_list names) (end_list)
         (set_tile "ds2" (itoa i-mline))
       )
     )

     (set_tile "onlyexp" (if (= only-export "1") "1" "0"))
     (set_tile "exp" (if (= do-export "1") "1" "0"))
     (start_list "efmt")
     (mapcar 'add_list (list "Excel" "Word" "Оба"))
     (end_list)
     (set_tile "efmt"
       (cond ((= export-fmt "Word") "1")
             ((= export-fmt "Оба") "2")
             (T "0")))

     (action_tile "accept"
       (strcat
         "(progn"
         (if (not priv)
           (strcat
             " (setq number-mode (if (= (get_tile \"num\") \"1\") \"Да\" \"Нет\"))"
             " (setq dim-mode (if (= (get_tile \"dim\") \"1\") \"Да\" \"Нет\"))"
             " (setq mline-prefix (nth (atoi (get_tile \"pref\")) (list \"L=\" \"L-\")))"
             " (setq num-choice (nth (atoi (get_tile \"numch\")) (list \"Авто\" \"Начальный номер точки\")))"
             " (setq start-num (get_tile \"start\"))"
             (if has-continue
               " (setq continue-mode (nth (atoi (get_tile \"cont\")) (list \"Продолжить\" \"Заново\")))"
               " (setq continue-mode \"Продолжить\")"
             )
           )
           " (setq number-mode \"Нет\" dim-mode \"Да\" mline-prefix \"L=\" num-choice \"Авто\" start-num \"1\" continue-mode \"Продолжить\")"
         )
         " (setq output-mode (nth (atoi (get_tile \"out\")) (list \"Мультивыноска\" \"Блок\")))"
         " (setq i-dim (atoi (get_tile \"ds1\")))"
         (if (not priv)
           " (setq i-mline (atoi (get_tile \"ds2\")))"
           " (setq i-mline i-dim)"
         )
         " (setq only-export (get_tile \"onlyexp\"))"
         " (setq do-export (get_tile \"exp\"))"
         " (setq export-fmt (nth (atoi (get_tile \"efmt\")) (list \"Excel\" \"Word\" \"Оба\")))"
         " (done_dialog 1))"
       )
     )
     (action_tile "cancel" "(done_dialog 0)")
     (setq res (start_dialog))
     (unload_dialog id)
     (vl-file-delete dclpath)

     (if (= res 1)
       (progn
         (vl:settings-put 'number-mode   number-mode)
         (vl:settings-put 'dim-mode      dim-mode)
         (vl:settings-put 'mline-prefix  mline-prefix)
         (vl:settings-put 'output-mode   output-mode)
         (vl:settings-put 'num-choice    num-choice)
         (vl:settings-put 'start-num     start-num)
         (vl:settings-put 'continue-mode continue-mode)
         (vl:settings-put 'dim-style     (nth i-dim names))
         (vl:settings-put 'mline-dim-style (nth i-mline names))
         (vl:settings-put 'do-export     do-export)
         (vl:settings-put 'export-fmt    export-fmt)
         (vl:settings-put 'only-export   only-export)
         (if priv
           (setq *VL:PRIV-DIM-CHOICE* (nth i-dim names))
           (setq *VL:DIM-CHOICE* (list (nth i-dim names) (nth i-mline names)))
         )
         (setq result
           (list
             (cons 'number-mode   number-mode)
             (cons 'dim-mode      dim-mode)
             (cons 'mline-prefix  mline-prefix)
             (cons 'output-mode   output-mode)
             (cons 'num-choice    num-choice)
             (cons 'start-num     start-num)
             (cons 'continue-mode continue-mode)
             (cons 'dim-style     (nth i-dim names))
             (cons 'mline-dim-style (nth i-mline names))
             (cons 'do-export     do-export)
             (cons 'export-fmt    export-fmt)
             (cons 'only-export   only-export)
           )
         )
       )
     )
    )
    (T
     (princ "\n  Не удалось открыть диалог настроек — использую значения по умолчанию.")
     (setq result
       (list
         (cons 'number-mode   (if priv "Нет" "Да"))
         (cons 'dim-mode      "Да")
         (cons 'mline-prefix  "L=")
         (cons 'output-mode   "Мультивыноска")
         (cons 'num-choice    "Авто")
         (cons 'start-num     "1")
         (cons 'continue-mode "Продолжить")
         (cons 'dim-style     def-dim)
         (cons 'mline-dim-style def-mline)
         (cons 'do-export     "0")
         (cons 'export-fmt    "Excel")
         (cons 'only-export   "0")
       )
     )
    )
  )
  result
)


;;; ------------------------------------------------------------
;;; Экранирование имени слоя для фильтра ssget
;;; (запятая, *, ? и прочие служебные символы).
;;; ------------------------------------------------------------
(defun vl:ss-escape (s / i c out)
  (setq out "" i 1)
  (repeat (strlen s)
    (setq c (substr s i 1))
    (if (member c '("`" "," "#" "." "@" "*" "?" "~" "[" "]"))
      (setq out (strcat out "`" c))
      (setq out (strcat out c))
    )
    (setq i (1+ i))
  )
  out
)

;;; Все полилинии модели на том же слое, что и образец.
(defun vl:similar-polys-on-layer (seed / ed lay ss)
  (setq ed (entget seed))
  (if (null ed)
    nil
    (progn
      (setq lay (cdr (assoc 8 ed)))
      (setq ss
        (ssget "_X"
          (list
            '(0 . "LWPOLYLINE,POLYLINE,3DPOLYLINE")
            '(410 . "Model")
            (cons 8 (vl:ss-escape lay))
          )
        )
      )
      (if (null ss)
        (progn
          (setq ss (ssadd))
          (ssadd seed ss)
        )
        (if (not (ssmemb seed ss))
          (ssadd seed ss)
        )
      )
      ss
    )
  )
)

;;; Привязка: одна полилиния -> подобные на слое -> пользователь
;;; снимает лишние (Shift) и Enter. Если уже выделено несколько
;;; полилиний, берём их как есть.
(defun vl:priv-pick-similar (/ ss seed ed lay n)
  (setq ss (ssget "_I" '((0 . "LWPOLYLINE,POLYLINE,3DPOLYLINE"))))
  (cond
    ((and ss (> (sslength ss) 1))
     (princ (strcat "\n  Используется текущий выбор: " (itoa (sslength ss)) " полилиний."))
     ss
    )
    (T
     (if (and ss (= (sslength ss) 1))
       (setq seed (ssname ss 0))
       (progn
         (princ "\n  Укажите одну полилинию — будут найдены подобные на том же слое.")
         (setq seed (car (entsel "\nПолилиния: ")))
       )
     )
     (if (or (null seed) (null (entget seed)))
       nil
       (progn
         (setq ed (entget seed))
         (if (not (member (cdr (assoc 0 ed)) '("LWPOLYLINE" "POLYLINE" "3DPOLYLINE")))
           (progn
             (princ "\n  Указанный объект не является полилинией.")
             nil
           )
           (progn
             (setq lay (cdr (assoc 8 ed)))
             (setq ss (vl:similar-polys-on-layer seed))
             (setq n (if ss (sslength ss) 0))
             (princ
               (strcat
                 "\n  Слой «" lay "»: подобных полилиний — " (itoa n) "."
               )
             )
             (if (<= n 1)
               ss
               (progn
                 (princ "\n  Они выделены. Снимите лишние (Shift+клик) и нажмите Enter.")
                 (setq *VL:SAVED-PICKADD* (getvar "PICKADD"))
                 (setvar "PICKADD" 1)
                 (sssetfirst nil nil)
                 (command "_.SELECT" ss pause)
                 (while (= (logand (getvar "CMDACTIVE") 1) 1)
                   (command pause)
                 )
                 (setvar "PICKADD" *VL:SAVED-PICKADD*)
                 (setq *VL:SAVED-PICKADD* nil)
                 (sssetfirst nil nil)
                 (setq ss (ssget "_P" '((0 . "LWPOLYLINE,POLYLINE,3DPOLYLINE"))))
                 (if ss
                   (princ (strcat "\n  К обработке: " (itoa (sslength ss)) " полилиний."))
                 )
                 ss
               )
             )
           )
         )
       )
     )
    )
  )
)

(defun vl:coord-main (priv / last0 sel ename vertices pt-count idx pt
                          x-coord y-coord real-x real-y coord-text
                          label-w label-h vert-pos poly-closed
                          mleader-style-name text-style-name actual-mleader-style
                          template-path export-data
                          txt-height land-length
                          pt-land pt-text
                          ml-ename num-ename
                          num-text num-ins-pt
                          dim-offset dim-text-gap seg-count seg-idx seg-pt1 seg-pt2
                          dim-style-name actual-dim-style-name
                          old-osmode old-cmdecho start-choice old-error-handler
                          output-mode coord-block-name block-scale
                          number-mode dim-mode mline-prefix
                          all-sel-verts other-verts-list parallel-search-dist en pr
                          processed-pts already num-choice
                          ss ename-list sel-idx dimmed-mlines-list
                          actual-mline-dim-style-name mline-dim-style-name dim-pick
                          existing-pts skipped
                          settings do-export export-fmt base-path
                          continue-mode start-num only-export)


  (vl-load-com)
 
  (vl:reset-placement-index)
  (setq *VL:DIM-ON-LINE* priv)

  (setq mleader-style-name "Координаты")
  (setq text-style-name    "Д-431")
  (setq dim-style-name     "длина сети iso")
  (setq mline-dim-style-name "Длина трубы iso")
  (setq coord-block-name "XY")

  (setq block-scale 1.0)

  (setq template-path *VL:TEMPLATE-PATH*)

  (setq old-osmode  (getvar "OSMODE"))
  (setq old-cmdecho (getvar "CMDECHO"))
  (setvar "CMDECHO" 0)
  (setvar "OSMODE"  0)

  (setq old-error-handler *error*)
  (defun *error* (msg)
    (setvar "OSMODE"  old-osmode)
    (setvar "CMDECHO" old-cmdecho)
    (if (and (boundp '*VL:SAVED-PICKADD*) (numberp *VL:SAVED-PICKADD*))
      (setvar "PICKADD" *VL:SAVED-PICKADD*)
    )
    (setq *VL:SAVED-PICKADD* nil)
    (setq *error* old-error-handler)
    (if (not (wcmatch (strcase msg) "*CANCEL*,*EXIT*,*QUIT*"))
      (princ (strcat "\n  ОШИБКА: " msg))
    )
    (princ "\n  Команда отменена.")
    (princ)
  )

  (if priv
    (princ "\n=== Привязка: координаты и размеры по полилинии ===")
    (princ "\n=== Простановка координатных выносок и размеров по полилинии ===")
  )

  (vl:ensure-text-style text-style-name)

  (if (vl:ensure-mleader-style-from-template template-path mleader-style-name)
    (setq actual-mleader-style mleader-style-name)
    (progn
      (princ "\n  Использую «Standard» как базу — параметры оформления")
      (princ "\n  назначаются вручную каждому объекту.")
      (setq actual-mleader-style "Standard")
    )
  )

  ;; --- Выбор полилиний ---
  ;; Привязка: клик по одной -> подобные на слое, лишние снимаются.
  ;; COORD: прежний множественный выбор (или уже выделенные).
  (if priv
    (setq ss (vl:priv-pick-similar))
    (progn
      (setq ss (ssget "_I" '((0 . "LWPOLYLINE,POLYLINE,3DPOLYLINE"))))
      (if ss
        (princ (strcat "\n  Используется текущий выбор: " (itoa (sslength ss)) " объект(ов)."))
        (progn
          (princ "\n  Выберите нужные полилинии (можно несколько).")
          (princ "\n  Когда все нужные объекты выбраны — нажмите ENTER, чтобы завершить выбор.")
          (setq ss (ssget '((0 . "LWPOLYLINE,POLYLINE,3DPOLYLINE"))))
        )
      )
    )
  )

  (if (null ss)
    (progn
      (princ "\n  Выбор отменён, либо не выбрано ни одной полилинии.")
      (princ)
      (exit)
    )
  )

  (setq ename-list '())
  (setq sel-idx 0)
  (repeat (sslength ss)
    (setq ename-list (append ename-list (list (ssname ss sel-idx))))
    (setq sel-idx (1+ sel-idx))
  )

  (princ (strcat "\n  Выбрано полилиний: " (itoa (length ename-list))))

  (if (and *VL:LAST-POLY-ENAME* (not (entget *VL:LAST-POLY-ENAME*)))
    (progn
      (setq *VL:LAST-VERTEX-NUM* nil)
      (setq *VL:COORD-MASTER-PT* nil)
      (setq *VL:ALL-EXPORT-DATA* '())
      (princ "\n Предыдущая полилиния была удалена. Счетчик сброшен.")
    )
  )

  ;; --- Одно окно настроек вместо серии getkword ---
  (setq dim-style-name     "длина сети iso")
  (setq mline-dim-style-name "Длина трубы iso")
  (setq settings
    (vl:settings-dialog
      priv
      template-path
      (if priv "Привязки" dim-style-name)
      mline-dim-style-name
    )
  )
  (if (null settings)
    (progn
      (princ "\n  Настройки отменены.")
      (exit)
    )
  )

  (setq number-mode   (cdr (assoc 'number-mode settings)))
  (setq dim-mode      (cdr (assoc 'dim-mode settings)))
  (setq mline-prefix  (cdr (assoc 'mline-prefix settings)))
  (setq output-mode   (cdr (assoc 'output-mode settings)))
  (setq num-choice    (cdr (assoc 'num-choice settings)))
  (setq start-num     (cdr (assoc 'start-num settings)))
  (setq continue-mode (cdr (assoc 'continue-mode settings)))
  (setq do-export     (cdr (assoc 'do-export settings)))
  (setq export-fmt    (cdr (assoc 'export-fmt settings)))
  (setq only-export   (cdr (assoc 'only-export settings)))
  (setq dim-style-name       (cdr (assoc 'dim-style settings)))
  (setq mline-dim-style-name (cdr (assoc 'mline-dim-style settings)))

  (if (null number-mode) (setq number-mode (if priv "Нет" "Да")))
  (if (null dim-mode) (setq dim-mode "Да"))
  (if (null mline-prefix) (setq mline-prefix "L="))
  (if (null output-mode) (setq output-mode "Мультивыноска"))
  (if (null num-choice) (setq num-choice "Авто"))
  (if (null do-export) (setq do-export "0"))
  (if (null export-fmt) (setq export-fmt "Excel"))
  (if (null only-export) (setq only-export "0"))

  ;; Если включён «Только экспорт» — отключаем простановку
  (if (= only-export "1")
    (progn
      (setq number-mode "Нет")
      (setq dim-mode    "Нет")
      (setq do-export   "1")
      ;; чистая таблица только по текущему выбору
      (setq *VL:ALL-EXPORT-DATA* '())
      (setq idx 1)
      (princ "\n  Режим: ТОЛЬКО ЭКСПОРТ (номера и размеры не ставятся).")
    )
  )

  ;; --- Подготовка размерных стилей ---
  (if (= dim-mode "Да")
    (progn
      (if (vl:ensure-dimstyle-from-template template-path dim-style-name)
        (setq actual-dim-style-name dim-style-name)
        (progn
          (princ "\n  Использую «Standard» как базовый размерный стиль.")
          (setq actual-dim-style-name "Standard")
        )
      )
      (if (not priv) (vl:force-dimstyle-text-below actual-dim-style-name))

      (if (vl:ensure-dimstyle-from-template template-path mline-dim-style-name)
        (setq actual-mline-dim-style-name mline-dim-style-name)
        (progn
          (princ "\n  Использую «Standard» как стиль размеров М-линий.")
          (setq actual-mline-dim-style-name "Standard")
        )
      )
      (if (not priv) (vl:force-dimstyle-text-below actual-mline-dim-style-name))
    )
    (progn
      (setq actual-dim-style-name       "Standard")
      (setq actual-mline-dim-style-name "Standard")
    )
  )

  (if (= output-mode "Блок")
    (vl:ensure-coord-block-from-template template-path coord-block-name)
  )

  ;; --- Нумерация ---
  (if (= number-mode "Нет")
    (setq idx 1)
    (progn
      (if (= num-choice "Начальный номер точки")
        (progn
          (setq idx (atoi (if start-num start-num "1")))
          (if (< idx 1) (setq idx 1))
        )
        ;; Авто
        (if (and *VL:LAST-VERTEX-NUM* (> *VL:LAST-VERTEX-NUM* 0))
          (if (or (null continue-mode) (= continue-mode "Продолжить"))
            (setq idx (1+ *VL:LAST-VERTEX-NUM*))
            (progn
              (setq idx 1)
              (setq *VL:ALL-EXPORT-DATA* nil)
            )
          )
          (setq idx 1)
        )
      )
    )
  )
  (princ (strcat "\n  Нумерация вершин начнётся с №" (itoa idx) "."))

  ;; --- Параметры оформления ---
  (setq txt-height  0.9)
  (setq land-length (* txt-height 1.5))
  (setq dim-offset    (if priv 0.0 1.0))
  (setq dim-text-gap  0.5)
  (setq parallel-search-dist 10.0)

  (setq export-data '())
  (setq processed-pts '())
  (setq existing-pts (vl:collect-existing-coord-pts coord-block-name))
  (setq dimmed-mlines-list '())

  ;; --- Собираем вершины всех выбранных полилиний ---
  (setq all-sel-verts '())
  (foreach en ename-list
    (setq all-sel-verts
      (append all-sel-verts (list (cons en (vl:get-polyline-vertices en))))
    )
  )

  (foreach ename ename-list
    (progn
      (setq vertices (vl:get-polyline-vertices ename))

      (setq other-verts-list '())
      (foreach pr all-sel-verts
        (if (and (not (eq (car pr) ename)) (cdr pr))
          (setq other-verts-list (cons (cdr pr) other-verts-list))
        )
      )

      (if (null vertices)
        (princ "\n  ОШИБКА: не удалось извлечь вершины полилинии, пропускаю объект.")
        (progn
          (setq pt-count (length vertices))
          (princ (strcat "\n\n  --- Обработка полилинии (" (itoa pt-count) " верш.) ---"))

          ;; ============================================================
          ;; ЧАСТЬ 1: координатные выноски и номера
          ;; ============================================================
          (setq last0 (entlast))
          (setq seg-count (1- pt-count))
          (setq vert-pos 0)
          (setq poly-closed (vl:polyline-closed-p ename))

          (setq skipped 0)
          (foreach pt vertices
            (setq already nil)
            (foreach ppt processed-pts
              (if (and (not already) (< (distance pt ppt) 0.001))
                (setq already T)
              )
            )
            ;; вершина уже размечена при прошлом запуске — пропускаем простановку
            (if (and (not already) (vl:pt-in-list-p pt existing-pts 0.01))
              (progn
                (setq already T)
                (setq skipped (1+ skipped))
              )
            )

            ;; --- ВСЕГДА собираем координаты для экспорта ---
            (setq real-x (car pt))
            (setq real-y (cadr pt))
            (setq x-coord real-y)
            (setq y-coord real-x)

            (setq *VL:ALL-EXPORT-DATA*
              (append *VL:ALL-EXPORT-DATA*
                (list (list idx (vl:fmt-coord x-coord) (vl:fmt-coord y-coord)))
              )
            )

            ;; --- Простановка только если вершина новая и не режим «только экспорт» ---
            (if (and (not already) (/= only-export "1"))
              (progn
                (setq coord-text (strcat "X= " (vl:fmt-coord x-coord) "\\PY= " (vl:fmt-coord y-coord)))

                (setq label-w (vl:estimate-text-width (strcat "X= " (vl:fmt-coord x-coord)) txt-height))
                (setq label-w (max label-w (vl:estimate-text-width (strcat "Y= " (vl:fmt-coord y-coord)) txt-height)))
                (setq label-h (* txt-height 2.8))
                (setq pt-land
                  (vl:find-label-placement (list real-x real-y 0.0) label-w label-h vertices seg-count land-length vert-pos poly-closed)
                )
                (setq pt-text (list (+ (car pt-land) land-length) (cadr pt-land) 0.0))

                (if (= output-mode "Мультивыноска")
                  (vl:create-mleader (list real-x real-y 0.0) pt-land pt-text coord-text actual-mleader-style land-length txt-height)
                  (vl:insert-coord-block
                    (list real-x real-y 0.0)
                    coord-block-name
                    (vl:fmt-coord x-coord)
                    (vl:fmt-coord y-coord)
                    block-scale
                    txt-height
                    0.0
                  )
                )

                (if (= number-mode "Да")
                  (vl:create-mtext-masked (list real-x real-y 0.0) (itoa idx) txt-height 0.0 1 text-style-name)
                )

                (setq processed-pts (cons pt processed-pts))
              )
            )

            ;; номер увеличиваем всегда — таблица экспорта со сплошной нумерацией
            (setq idx (1+ idx))
            (setq vert-pos (1+ vert-pos))
          )

          (setq *VL:LAST-POLY-ENAME* ename)
          (if (> skipped 0)
            (princ (strcat "\n  Пропущено вершин с уже существующей меткой: " (itoa skipped)))
          )
          (setq *VL:LAST-VERTEX-NUM* (1- idx))

          ;; ============================================================
          ;; ЧАСТЬ 2: простановка размеров по сторонам полигона
          ;; ============================================================
          (if (= dim-mode "Да")
            (progn
              (setq seg-count (1- pt-count))
              (setq seg-idx 0)

              (repeat seg-count
                (if (or priv
                        (not (vl:mline-near-segment-p
                               (nth seg-idx vertices)
                               (nth (1+ seg-idx) vertices)
                               2.0)))
                  (vl:create-parallel-dim-with-label
                    (nth seg-idx vertices)
                    (nth (1+ seg-idx) vertices)
                    dim-offset
                    txt-height
                    actual-dim-style-name
                    actual-mleader-style
                    dim-text-gap
                    other-verts-list
                    parallel-search-dist
                  )
                )
                (setq seg-idx (1+ seg-idx))
              )

              (if (and (vl:polyline-closed-p ename)
                       (or priv
                           (not (vl:mline-near-segment-p
                                  (last vertices)
                                  (car vertices)
                                  5.0))))
                (vl:create-parallel-dim-with-label
                  (nth seg-idx vertices)
                  (nth (1+ seg-idx) vertices)
                  dim-offset
                  txt-height
                  actual-dim-style-name
                  actual-mleader-style
                  dim-text-gap
                  other-verts-list
                  parallel-search-dist
                )
              )
              (if (not priv)
                (setq dimmed-mlines-list
                  (vl:dim-mlines-near-polyline
                    ename
                    vertices
                    5.0
                    txt-height
                    actual-mline-dim-style-name
                    actual-mleader-style
                    mline-prefix
                    dimmed-mlines-list
                  )
                )
              )
            )
          )

          ;; --- Привязка: слой и цвет новых объектов - по полилинии ---
          (if priv (vl:apply-poly-props last0 ename))
        )
      )
    )
  )

  (setq *VL:DIM-ON-LINE* nil)
  ;; экспорт только если включён флажок в диалоге
  (if (and (= do-export "1") *VL:ALL-EXPORT-DATA*)
    (progn
      (setq base-path
        (getfiled "Укажите имя файла для экспорта" "координаты" "csv" 1)
      )
      (if (null base-path)
        (princ "\n  Экспорт отменён пользователем.")
        (progn
          (if (wcmatch (strcase base-path) "*.CSV")
            (setq base-path (substr base-path 1 (- (strlen base-path) 4)))
          )
          (cond
            ((= export-fmt "Excel")
             (vl:export-csv *VL:ALL-EXPORT-DATA* (strcat base-path ".csv"))
            )
            ((= export-fmt "Word")
             (vl:export-rtf *VL:ALL-EXPORT-DATA* (strcat base-path ".rtf"))
            )
            ((= export-fmt "Оба")
             (vl:export-csv *VL:ALL-EXPORT-DATA* (strcat base-path ".csv"))
             (vl:export-rtf *VL:ALL-EXPORT-DATA* (strcat base-path ".rtf"))
            )
          )
        )
      )
    )
    (if (= do-export "1")
      (princ "\n  Нет данных для экспорта.")
      (princ "\n  Экспорт пропущен (флажок выключен).")
    )
  )

  (setvar "OSMODE" old-osmode)
  (setvar "CMDECHO" old-cmdecho)
  (setq *error* old-error-handler)

  (command "_.REGEN")
  (if priv
    (princ "\n=== Привязка завершена ===")
    (princ "\n=== COORD завершена ===")
  )
  (princ)
)

