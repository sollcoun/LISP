(defun vl:base64-decode-to-file (b64-chunks out-path / txt-path f wsh cmd result)
  (setq txt-path (strcat (vl-filename-directory out-path) "\\vertex_leaders_template.b64.txt"))
  (if (findfile out-path)
    (vl-file-delete out-path)
  )
  (setq f (open txt-path "w"))
  (foreach chunk b64-chunks (write-line chunk f))
  (close f)
  (setq wsh (vlax-create-object "WScript.Shell"))
  (setq cmd (strcat "certutil -decode \"" txt-path "\" \"" out-path "\""))
  (setq result (vlax-invoke wsh 'Run cmd 0 :vlax-true))
  (vlax-release-object wsh)
  (vl-file-delete txt-path)
  (if (= result 0)
    out-path
    (progn
      (princ (strcat "\n  certutil завершился с кодом ошибки: " (itoa result)))
      nil
    )
  )
)


